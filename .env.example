# =====================================================================
# LinguistFlow AI — v2 (Python unified backend) — environment template
# Copy to .env and fill in values. NEVER commit .env.
# =====================================================================

# --- App ---------------------------------------------------------------
APP_ENV=production
LOG_LEVEL=INFO

# --- Databases ---------------------------------------------------------
MONGO_USERNAME=linguist_admin
MONGO_PASSWORD=change-me-strong-password
MONGO_DATABASE=linguistflow

NEO4J_PASSWORD=change-me-strong-password

# --- Frontend / CORS / Rate limit -------------------------------------
FRONTEND_ORIGIN=http://localhost:8501
RATE_LIMIT=30/minute
MAX_UPLOAD_BYTES=10485760

# --- Speech ------------------------------------------------------------
WHISPER_MODEL=base

# --- LLM defaults ------------------------------------------------------
LLM_DEFAULT_PROVIDER=ollama
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=120

# --- Provider flags ---------------------------------------------------
LLM_OPENAI_ENABLED=false
LLM_CLAUDE_ENABLED=false
LLM_GEMINI_ENABLED=false
LLM_OPENROUTER_ENABLED=false
LLM_OLLAMA_ENABLED=true

# --- Provider API keys (required only when enabled) ------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- Provider model whitelists (CSV) ---------------------------------
LLM_OPENAI_MODELS=gpt-4o-mini,gpt-4o
LLM_CLAUDE_MODELS=claude-haiku-4-5,claude-sonnet-4-6,claude-opus-4-7
LLM_GEMINI_MODELS=gemini-2.0-flash,gemini-2.5-pro,gemini-1.5-flash
LLM_OPENROUTER_MODELS=openai/gpt-4o-mini,anthropic/claude-3.5-sonnet,meta-llama/llama-3.1-70b-instruct
LLM_OLLAMA_MODELS=llama3.2,mistral,qwen2.5,phi3

# --- Provider URLs ----------------------------------------------------
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OLLAMA_URL=http://ollama:11434
